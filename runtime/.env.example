# Copy to a node-specific file. Never commit the populated file.
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1
DSPARK_MODEL=/model
MODEL_PATH=/absolute/path/to/DeepSeek-V4-Flash-0731
DSPARK_ENCODING_FILE=/model/encoding/encoding_dsv4.py
HF_CACHE=/absolute/path/to/huggingface-cache
DSPARK_TMP_HOST=/absolute/path/to/dspark-tmp

# Both ranks use the head node's RoCE/fabric address here.
MASTER_ADDR=REPLACE_WITH_HEAD_FABRIC_IP
MASTER_PORT=25000

# Set this to the current node's RoCE/fabric address.
VLLM_HOST_IP=REPLACE_WITH_THIS_NODE_FABRIC_IP

# Head API settings. Worker is headless.
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
SERVED_MODEL_NAME=deepseek-v4-flash-0731

# Discover from the live node. Do not assume the same GID index on both ranks.
NCCL_IB_HCA=mlx5_0
NCCL_SOCKET_IFNAME=REPLACE_WITH_FABRIC_INTERFACE
TP_SOCKET_IFNAME=REPLACE_WITH_FABRIC_INTERFACE
GLOO_SOCKET_IFNAME=REPLACE_WITH_FABRIC_INTERFACE
NCCL_IB_GID_INDEX=REPLACE_WITH_NODE_SPECIFIC_ROCEV2_GID_INDEX
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2

MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
MTP_NUM_TOKENS=5
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_B12X_MOE=1
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
ENABLE_VLLM_GB10_PATCH=0
